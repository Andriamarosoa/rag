APP_HOST=0.0.0.0
APP_PORT=8765
DATABASE_PATH=data/rag.db
RULES_PATH=config/rules

# Context compaction
CONTEXT_COMPACT_AT_TOKENS=50000
CONTEXT_KEEP_RECENT_TOKENS=12000
CONTEXT_SUMMARY_TARGET_TOKENS=8000

# Codex CLI is installed in the backend Docker image.
# Version 0.146.1 is pinned because this prototype currently uses the legacy stdio MCP server adapter.
CODEX_VERSION=0.146.1
CODEX_COMMAND=codex
CODEX_ARGS=mcp-server
CODEX_TOOL=codex
CODEX_REPLY_TOOL=codex-reply
CODEX_CWD=/app
CODEX_MODEL=qwen3:8b
CODEX_SANDBOX=read-only
CODEX_APPROVAL_POLICY=never

# Remote Ollama over Tailscale. Keep /v1 here because Codex uses Ollama's OpenAI-compatible API.
CODEX_OSS_BASE_URL=http://100.89.128.87:11434/v1

# Fast assistant_decision path. This uses Ollama native /api/chat with think=false.
OLLAMA_BASE_URL=http://100.89.128.87:11434
OLLAMA_MODEL=qwen3:8b

# Sicorax Knowledge Base (SKB). Modules are discovered at runtime and exposed in
# search_skb's input schema, which is included in assistant_decision prompts.
SKB_BASE_URL=http://skb.uniconsults.mu/
SKB_REQUEST_TIMEOUT_SECONDS=5
SKB_MODULE_CACHE_SECONDS=600
SKB_SEARCH_MAX_PAGES=30

# Email agent (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_STARTTLS=true
