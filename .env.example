APP_HOST=0.0.0.0
APP_PORT=8765
DATABASE_PATH=data/rag.db
RULES_PATH=config/rules.json

# Context compaction
CONTEXT_COMPACT_AT_TOKENS=50000
CONTEXT_KEEP_RECENT_TOKENS=12000
CONTEXT_SUMMARY_TARGET_TOKENS=8000

# Codex MCP (legacy/deprecated as of 2026-08-24, kept because this prototype explicitly targets MCP)
CODEX_COMMAND=codex
CODEX_ARGS=mcp-server
CODEX_TOOL=codex
CODEX_REPLY_TOOL=codex-reply
CODEX_CWD=.
CODEX_MODEL=
CODEX_SANDBOX=read-only
CODEX_APPROVAL_POLICY=never

# Email agent (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_STARTTLS=true
