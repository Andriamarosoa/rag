# Local Docker development stack
APP_PORT=8765
APP_BIND_ADDRESS=0.0.0.0
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=http://[^/]+:8080

# Context compaction
CONTEXT_COMPACT_AT_TOKENS=50000
CONTEXT_KEEP_RECENT_TOKENS=12000
CONTEXT_SUMMARY_TARGET_TOKENS=8000

# Codex and local Ollama chat model
CODEX_VERSION=0.146.1
CODEX_MODEL=qwen3:8b
CODEX_SANDBOX=read-only
CODEX_OSS_BASE_URL=http://ollama:11434/v1
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b

# Sicorax Knowledge Base
SKB_BASE_URL=http://skb.uniconsults.mu/
SKB_REQUEST_TIMEOUT_SECONDS=15
SKB_MODULE_CACHE_SECONDS=600
SKB_SEARCH_MAX_PAGES=30

# Persistent semantic index
SKB_EMBEDDING_BASE_URL=http://ollama:11434
SKB_EMBEDDING_MODEL=bge-m3
SKB_EMBEDDING_DIMENSION=1024
SKB_EMBEDDING_BATCH_SIZE=16
SKB_EMBEDDING_TIMEOUT_SECONDS=180
SKB_CRAWL_CONCURRENCY=3
SKB_CHUNK_SIZE=1600
SKB_CHUNK_OVERLAP=200
SKB_MIN_CHUNK_SIZE=80
SKB_RETRIEVAL_TOP_K=3
SKB_RETRIEVAL_MAX_DISTANCE=0.45
SKB_AMBIGUITY_DISTANCE_DELTA=0.02
SKB_ANSWER_MAX_CONTEXT_CHARACTERS=24000
SKB_SYNC_ON_STARTUP=true

# Persistent DOCX resources
KNOWLEDGE_UPLOAD_MAX_BYTES=15728640

# MariaDB on the Docker network
MARIADB_ROOT_PASSWORD=rootpassword
DB_HOST=mariadb
DB_PORT=3306
DB_USER=myuser
DB_PASSWORD=myuserpassword
DB_NAME=sicorax
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_CONNECT_TIMEOUT_SECONDS=10
